// Sendvoice data model — PRD §7 (one expressive core, not per-vertical forks)
// and §9.2 (multi-tenant, row-level isolation enforced at the DB, not the app).
//
// Row-level security policies are applied via a raw-SQL migration
// (see prisma/migrations/.../rls.sql) — Prisma's schema DSL doesn't express
// RLS directly. Every tenant-scoped table below carries a tenantId column
// that the RLS policy filters on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
  ACCOUNTANT
}

enum DocType {
  QUOTE
  PROFORMA
  INVOICE
  CREDIT_NOTE
  RECEIPT
  DELIVERY_NOTE
  STATEMENT
}

enum DocStatus {
  DRAFT
  APPROVED
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  // Quote-only responses (PRD §7.3/§10.2 "accept/decline"), captured from
  // the public hosted page — a plain form POST, not a WhatsApp quick-reply
  // button, since Rail B doesn't exist yet. Never used on an INVOICE.
  ACCEPTED
  DECLINED
}

enum LineType {
  ITEM
  SERVICE
  LABOUR
  EXPENSE
  DISCOUNT
  DEPOSIT
  SUBTOTAL_HEADER
}

enum DeliveryRail {
  RAIL_A_ASSISTED
  RAIL_B_DIRECT
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id          String   @id @default(cuid())
  legalName   String
  tradingName String?
  country     String // ISO 3166-1 alpha-2 — keys tax profile + payment routing
  currency    String // ISO 4217
  taxId       String?
  // PRD §6.1 onboarding field — every PDF template already had a slot for
  // this ("No business address field on Tenant yet" was the exact gap),
  // it just had nothing to render. Optional/skippable like every other
  // onboarding field; free text rather than structured street/city/etc.
  // since invoices need a single printable block, not a queryable address.
  address     String?
  logoUrl     String? // unused for now — see logoData
  // PRD §6.1: onboarding's "logo (optional, skippable)". Stored inline
  // (like Document.pdfData) rather than served from a URL — both the PDF
  // and the hosted page are rendered server-side with the full Tenant
  // already in hand, so embedding a data: URI at render time needs no
  // separate public serving route at all.
  logoData     Bytes?
  logoMimeType String?
  // PRD §8.5 P0: which of the (eventually 3-4) PDF templates this tenant's
  // invoices render with — a signup-time choice, not a per-invoice one.
  // Unrecognized values fall back to "classic" at render time rather than
  // failing an approval (see services/pdf/template.ts).
  pdfTemplate String @default("classic")
  // PRD §4.3: "viral coefficient (recipient→signup attribution)". The raw
  // `ref` query param a signup arrived with (a hosted invoice's token, at
  // the only source wired up so far) — stored unresolved, not joined to the
  // referring Tenant at write time, since a token can be revoked/replaced
  // long before anyone analyzes this; resolving it is an analysis-time
  // concern, not a signup-time one. Null means organic/direct signup.
  referralSource String?
  // PRD §8.1 P0 onboarding field ("bank details") / §8.7 P1 ("bank transfer
  // instructions rendered on the PDF with a copy-to-clipboard account
  // number"). Structured (not one free-text block like address) because the
  // account number specifically needs to be its own copyable field, not
  // buried in a paragraph. All optional/skippable — a merchant who only
  // takes cash never needs these, and rendering is conditional on
  // bankAccountNumber being set (see pdf/shared.ts, hostedInvoicePage.ts).
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  createdAt      DateTime @default(now())

  users         User[]
  customers     Customer[]
  documents     Document[]
  numberSeries  NumberSeries[]
  taxProfiles   TaxProfile[]
  items         Item[]
  waba          WabaConnection?
  paymentLinks  PaymentProviderLink[]
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  phone    String @unique // E.164 — primary identity, PRD §8.1
  name     String?
  role     Role   @default(OWNER)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  whatsapp     String? // E.164
  email        String?
  address      String?
  taxId        String?
  notes        String?
  optedInAt    DateTime? // WhatsApp consent capture — PRD §10.3
  optedOutAt   DateTime?
  createdAt    DateTime @default(now())

  documents Document[]

  @@index([tenantId])
  // PRD §8.2 P1 "duplicate detection on number": enforced here rather than
  // as an app-level check. Nulls are distinct under Postgres uniqueness, so
  // customers without a WhatsApp number never collide.
  @@unique([tenantId, whatsapp])
}

// Per-series, per-year sequential counters — PRD §9.4. Numbers are only
// ever allocated inside the approval transaction, never at draft time.
model NumberSeries {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  docType  DocType
  prefix   String
  year     Int
  lastSeq  Int     @default(0)

  @@unique([tenantId, docType, year])
}

model TaxProfile {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  version   Int      @default(1) // historical invoices pin a version — never re-render with new rates
  rules     Json // { mode: 'none'|'inclusive'|'exclusive'|'multi_rate'|'compound'|'withholding'|'reverse_charge', rates: [...] }
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// PRD §8.3 P1 "item catalogue auto-save with fuzzy recall": every line a
// merchant approves is upserted here (services/invoices.ts, same
// transaction as the invoice itself — the same inline-dedup pattern as
// Customer), so the composer can suggest past items as they type instead
// of retyping the same line every invoice. normalizedDescription is the
// dedup/lookup key (lowercased/trimmed); description keeps the original
// casing for display. Fuzzy matching itself is pg_trgm (see the migration
// — not expressible in the Prisma schema DSL, same reason RLS lives there).
model Item {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  description            String
  normalizedDescription  String
  unit                   String?
  rate                   Decimal  @db.Decimal(14, 2)
  useCount               Int      @default(1)
  lastUsedAt             DateTime @default(now())
  createdAt              DateTime @default(now())

  @@unique([tenantId, normalizedDescription])
  @@index([tenantId, lastUsedAt])
}

// A draft is client-owned (ULID, offline-capable). It becomes a Document
// only at approval, inside a transaction that allocates the number.
model Document {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  // Idempotency key for /invoices/:draftId/approve — a retried request
  // (flaky connection, our own outbox flush) must never create a second
  // invoice for one merchant action. NULL for documents created before this
  // existed or through a future path that doesn't need it.
  draftId        String?
  docType        DocType
  number         String? // null until approved
  status         DocStatus @default(DRAFT)
  currency       String
  taxProfileId   String?
  taxProfileVersion Int?
  issueDate      DateTime?
  dueDate        DateTime?
  notes          String?
  subtotal       Decimal   @db.Decimal(14, 2)
  taxTotal       Decimal   @db.Decimal(14, 2)
  total          Decimal   @db.Decimal(14, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(14, 2)
  convertedFromId String?  // quote→invoice lineage (PRD §7.3)
  pdfUrl         String? // set to /invoices/:id/pdf once rendered
  // Stored in Postgres for now, not real object storage — see the note in
  // src/services/pdf.ts. Swappable behind renderAndStorePdf() without
  // touching callers once a real object store is provisioned (needed
  // anyway once the hosted invoice page and WhatsApp document headers want
  // a public, unauthenticated URL).
  pdfData        Bytes?
  // PRD §12 P0: hosted invoice URLs are bearer tokens for financial data —
  // high-entropy, never sequential/guessable, expiring, revocable. Revoking
  // today means clearing hostedToken; a documented reason/log is remaining
  // work. Resolved by the public hosted-page route via a SECURITY DEFINER
  // function (resolve_document_by_token), the same pattern as login — this
  // is the one other legitimate cross-tenant lookup in the app.
  hostedToken           String?   @unique
  hostedTokenExpiresAt  DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines      DocumentLine[]
  deliveries Delivery[]
  payments   Payment[]
  events     DocumentEvent[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@unique([tenantId, docType, number])
  @@unique([tenantId, draftId])
}

model DocumentLine {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  position    Int
  type        LineType @default(ITEM)
  description String
  qty         Decimal? @db.Decimal(12, 3)
  unit        String?
  rate        Decimal  @db.Decimal(14, 2)
  discount    Decimal? @db.Decimal(14, 2)
  taxCode     String?
  imageUrl    String?
  note        String?

  @@index([documentId])
}

// Append-only audit trail for every state transition on an approved
// document — PRD §12 P0.
model DocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  type       String // 'approved' | 'status_changed' | 'reminder_sent' | 'voided' | ...
  data       Json?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model Delivery {
  id         String         @id @default(cuid())
  documentId String
  document   Document       @relation(fields: [documentId], references: [id])
  rail       DeliveryRail
  status     DeliveryStatus @default(QUEUED)
  templateId String? // Rail B only — which approved template was used
  idempotencyKey String     @unique
  attempts   Int            @default(0)
  lastError  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([documentId])
}

model Payment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  method     String // 'psp' | 'cash' | 'bank_transfer'
  provider   String? // 'paystack' | 'flutterwave' | 'stripe' | 'razorpay' | 'mercadopago' | 'xendit'
  reference  String?
  recordedAt DateTime @default(now())

  @@index([documentId])
  // PRD §9.5: "every WhatsApp send is idempotent" — the same discipline
  // applies to PSP confirmations. A Paystack webhook retry and the hosted
  // page's own post-payment redirect (services/payments.ts) can both race
  // to record the identical transaction; this constraint is what makes the
  // second one a no-op instead of a double payment. Postgres treats NULL as
  // distinct from NULL, so manual cash/bank_transfer payments (both fields
  // null) never collide with each other or with this constraint.
  @@unique([provider, reference])
}

// Per-tenant WABA — Embedded Signup grants revocable access; each merchant
// keeps their own WABA inside their own Meta Business Portfolio (PRD §10.1).
model WabaConnection {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  wabaId        String?
  phoneNumberId String?
  qualityRating String? // mirrors Meta's quality webhook
  status        String  @default("not_connected") // not_connected | pending | connected | throttled
  // Telnyx's Hosted Signup session id (POST /v2/whatsapp/hosted_signups'
  // response `id`) — stored so services/waba.ts can poll
  // GET /v2/whatsapp/signup/{id}/status for this specific tenant without
  // Telnyx needing to know our tenantId at all (the hosted signup URL has
  // no field for a caller-supplied reference; correlation happens entirely
  // on our side, by only ever polling the id we ourselves stored here).
  signupSessionId String?
  connectedAt     DateTime?

  templates WabaTemplate[]
}

model WabaTemplate {
  id         String         @id @default(cuid())
  wabaId     String
  waba       WabaConnection @relation(fields: [wabaId], references: [id])
  name       String // invoice_new | invoice_reminder_due | invoice_reminder_overdue | payment_received | quote_new
  // Telnyx's own template id (POST /whatsapp/message_templates' response
  // `id`), needed to poll for a status change after submission — separate
  // from `name`, which is ours and stays stable across a rejection+resubmit.
  telnyxTemplateId String?
  // Telnyx's real status values (POST .../message_templates' documented
  // response), not values we invented: PENDING | APPROVED | REJECTED |
  // PAUSED | DISABLED. Stored verbatim rather than translated, so a status
  // Telnyx adds later doesn't need a schema/code change to pass through.
  status     String
  rejectionReason String?
  updatedAt  DateTime @updatedAt

  @@unique([wabaId, name])
}

model PaymentProviderLink {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  provider   String // paystack | flutterwave | stripe | razorpay | mercadopago | xendit
  status     String  @default("not_connected")
  externalId String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// Per-tenant, per-market send-cost ledger — PRD §10.4, day-one requirement,
// not a v2 feature. Keys on recipient country, not merchant country.
model SendCostLedgerEntry {
  id               String   @id @default(cuid())
  tenantId         String
  recipientCountry String
  category         String // utility | authentication | marketing | business_agent
  units            Int      @default(1)
  costMinorUnits   Int // cost in the smallest currency unit, e.g. cents
  currency         String
  occurredAt       DateTime @default(now())

  @@index([tenantId, occurredAt])
}
