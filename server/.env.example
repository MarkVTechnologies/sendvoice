# Copy to .env and fill in for local development.

# Postgres (row-level security policies applied via prisma/migrations — PRD §9.2, §12)
#
# Two roles, on purpose: whatever DB provider you use, the default/owner role
# commonly has BYPASSRLS (Neon's neondb_owner does), so RLS policies can't
# restrict it no matter what. The app must connect as a separate, restricted
# role (see scripts/create-app-role.ts) or tenant isolation silently does
# nothing.
#
# DATABASE_URL: what the app runtime connects as (restricted role). If your
# provider offers both a pooled (PgBouncer) and a direct endpoint — Neon
# does — use the POOLED one here. Found the hard way: the direct endpoint's
# concurrent-connection cap is low, and requests started hanging
# indefinitely (not erroring) once a few were in flight. Safe with
# transaction-mode pooling because withTenant() sets app.tenant_id as
# transaction-local (`set_config(..., true)`), not session-scoped.
DATABASE_URL="postgresql://sendvoice_app:sendvoice@localhost:5432/sendvoice?schema=public"
# MIGRATE_DATABASE_URL: owner/DDL connection, used only by prisma.config.ts.
# Needs the DIRECT endpoint — Prisma Migrate needs session mode, which
# PgBouncer transaction-mode pooling doesn't support.
MIGRATE_DATABASE_URL="postgresql://sendvoice:sendvoice@localhost:5432/sendvoice?schema=public"

# Redis-backed durable job queue (sends, retries, reminders, webhooks — PRD §9.2)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me"
OTP_PROVIDER=whatsapp # whatsapp | sms

# WhatsApp OTP delivery via Telnyx (PRD §8.1/§10.1; BSP decided for cost —
# see DEVELOPMENT_PLAN.md Open Decision #1). All four of these need a real
# Telnyx account: TELNYX_API_KEY from the Telnyx dashboard; WHATSAPP_FROM is
# the WhatsApp-enabled number tied to your Meta WhatsApp Business Account
# (WABA); OTP_TEMPLATE_NAME is a utility-category template you've submitted
# and Meta has approved (a plain-text message can't open a conversation —
# only a pre-approved template can, and a signup OTP is always the first
# contact). Until all three of API key / from-number / template name are
# set, the server falls back to logging the code instead of sending it
# (see routes/auth.ts, services/telnyx.ts) — safe for local dev, not for
# production. SMS_FROM is optional: a Telnyx SMS-capable number to fall
# back to if the WhatsApp send itself fails.
TELNYX_API_KEY=
TELNYX_WHATSAPP_FROM=
TELNYX_OTP_TEMPLATE_NAME=
TELNYX_OTP_TEMPLATE_LANG=en_US
TELNYX_SMS_FROM=

# Rail B (PRD §10): per-merchant WABA connection via Telnyx's "Hosted
# Signup" (services/telnyx.ts, services/waba.ts, routes/waba.ts) — a URL we
# hand the merchant, with Telnyx handling Meta's actual signup flow and
# WABA/number registration, rather than us embedding Meta's JS SDK
# ourselves. TELNYX_APP_ID is the Meta App ID registered under the Meta
# Tech Provider program and linked to Telnyx — a separate, much heavier
# prerequisite than the OTP setup above: Meta Tech Provider approval, a
# Meta Business Account, and the App switched to Live mode before Telnyx
# will accept it. Until this and TELNYX_API_KEY are both set,
# isEmbeddedSignupConfigured() is false and "Connect WhatsApp Business"
# stays disabled with an honest message, same pattern as Pay Now before
# Paystack is configured.
#
# Once a WABA is connected, submitting the five core templates
# (invoice_new, invoice_reminder_due, invoice_reminder_overdue,
# payment_received, quote_new — all UTILITY category per PRD §10.2) and
# sending an actual invoice both reuse TELNYX_API_KEY; no further env vars
# are needed for those.
#
# Several exact wire details here (the hosted-signup session id's field
# name, the DOCUMENT-header template example mechanics, a GET-by-id
# endpoint for template status) are inferred from thin/partial Telnyx docs,
# not confirmed against a live account — flagged in the relevant comments
# in services/telnyx.ts. Re-verify against a real account before trusting
# this in production.
TELNYX_APP_ID=

# PDF rendering (PRD §9.2 P0: server-side, never client-side).
# Points puppeteer-core at an already-installed Chrome — sidesteps bundling
# a downloaded Chromium, which this dev machine's disk can't reliably fit.
# Not a production choice: a real deployment needs a headless Chromium the
# runtime actually ships (e.g. @sparticuz/chromium, or a container image
# with Chrome installed). Default below is the common Windows install path.
CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# Object storage for rendered PDFs — not wired up yet. PDFs are currently
# stored as bytea on Document (inherits its RLS for free) rather than a
# real object store; see the note in src/services/pdf.ts. Needed for real
# once the hosted invoice page and WhatsApp document headers want a public,
# unauthenticated URL.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# Payment providers — regional routing (PRD §8.7). Only fill in the ones
# live for the current launch market.
#
# Paystack (Nigeria/Ghana/South Africa/Kenya) is wired end-to-end:
# services/paystack.ts, the hosted page's Pay Now (routes/hosted.ts's
# /:token/pay + /pay/callback), and the webhook handler
# (routes/webhooks.ts's POST /api/webhooks/payments/paystack, which is the
# authoritative confirmation — the callback route is UX only). Needs a real
# Paystack account: PAYSTACK_SECRET_KEY from the dashboard, and that same
# webhook URL registered in Settings → API Keys & Webhooks. Until the key
# is set, isPaystackConfigured() is false and the hosted page keeps the
# existing honest disabled "Pay Now" state. Money currently settles to the
# platform's own Paystack account, not a per-merchant one — real
# per-merchant payout (a Paystack Subaccount funded from the bank details
# already collected at onboarding) is unbuilt follow-up work.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
XENDIT_SECRET_KEY=

PORT=4177
NODE_ENV=development

# Needs to be a real absolute URL in production — PUBLIC_BASE_URL goes into
# wa.me pre-filled messages (Rail A) and the hosted invoice page's own URLs;
# CLIENT_URL is the client SPA's own origin, used only by the hosted page's
# footer CTA (PRD §4.3 viral coefficient) since the client is a different
# origin/port from the API in dev. Both default to localhost equivalents.
PUBLIC_BASE_URL=http://localhost:4177
CLIENT_URL=http://localhost:5173
